{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videomaker.local/schemas/material-review-report.schema.json",
  "title": "MaterialReviewReport",
  "type": "object",
  "required": ["slotId", "generationId", "reviewedAt", "approved", "issues", "suggestions", "reviewInputs"],
  "properties": {
    "slotId": { "type": "string", "minLength": 1 },
    "generationId": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "approved": { "type": "boolean" },
    "hardGateFailed": { "type": "boolean" },
    "scores": {
      "type": "object",
      "properties": {
        "briefAlignment": { "type": "number", "minimum": 1, "maximum": 5 },
        "visualHierarchy": { "type": "number", "minimum": 1, "maximum": 5 },
        "copyPolicy": { "type": "number", "minimum": 1, "maximum": 5 },
        "motionQuality": { "type": "number", "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "issues": { "type": "array", "items": { "type": "string" } },
    "suggestions": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "specHash": { "type": "string", "minLength": 1 },
    "previewSha256": { "type": "string", "minLength": 1 },
    "reviewInputs": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["video", "frames", "text_only", "skipped"]
        },
        "videoPath": { "type": "string" },
        "framePaths": { "type": "array", "items": { "type": "string" } },
        "frameTimestamps": { "type": "array", "items": { "type": "number" } },
        "beatSources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["spec_timeline", "spec_html", "ratio_fill"]
          }
        },
        "reviewReuse": {
          "type": "string",
          "enum": ["in_session", "report_reused"]
        }
      },
      "additionalProperties": false
    },
    "reviewPhase": {
      "type": "string",
      "enum": ["in_session", "promoted"]
    },
    "finalSource": {
      "type": "string",
      "enum": ["preview_copy", "render"]
    },
    "reviewBypass": { "type": "string" },
    "agentReviewRound": { "type": "integer", "minimum": 0 },
    "provider": { "type": "string" },
    "reviewUnavailable": { "type": "boolean" },
    "previewArtifactRef": { "$ref": "artifact-ref.schema.json" },
    "trace": {
      "type": "object",
      "properties": {
        "reviewRoute": {
          "type": "string",
          "enum": ["video", "frames", "text_only", "skipped", "hard_gate", "promoted"]
        },
        "modelCallId": { "type": "string" },
        "agentRunId": { "type": "string" },
        "promptVersion": { "type": "string" },
        "parentObservabilityRunId": { "type": "string" },
        "reviewClassification": {
          "type": "string",
          "enum": ["approved", "creative", "infrastructure", "unknown", "infrastructure_waived"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
