{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videomaker.local/schemas/material-reviewer-output.schema.json",
  "title": "MaterialReviewerOutput",
  "type": "object",
  "required": ["approved", "issues", "suggestions"],
  "properties": {
    "approved": { "type": "boolean" },
    "scores": {
      "type": "object",
      "properties": {
        "briefAlignment": { "type": "number", "minimum": 1, "maximum": 5 },
        "visualHierarchy": { "type": "number", "minimum": 1, "maximum": 5 },
        "copyPolicy": { "type": "number", "minimum": 1, "maximum": 5 },
        "motionQuality": { "type": "number", "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "issues": { "type": "array", "items": { "type": "string" } },
    "suggestions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
