{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videomaker.local/schemas/usage-units.schema.json",
  "title": "UsageUnits",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["tokens", "chars", "images", "video_seconds"]
    },
    "prompt": { "type": "number", "minimum": 0 },
    "completion": { "type": "number", "minimum": 0 },
    "total": { "type": "number", "minimum": 0 },
    "chars": { "type": "number", "minimum": 0 },
    "images": { "type": "number", "minimum": 0 },
    "calls": { "type": "number", "minimum": 0 },
    "requestedDurationSec": { "type": "number", "minimum": 0 },
    "actualDurationSec": { "type": "number", "minimum": 0 }
  },
  "additionalProperties": false
}
