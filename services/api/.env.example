# Copy to services/api/.env (gitignored). Loaded automatically by run-dev.ps1.
# Worker subprocesses inherit these variables for generation / material completion.

# --- Composition material author ---
# react = built-in ReAct | acp = external agent (Claude / Codex / Cursor)
VIDEOMAKER_COMPOSITION_AUTHOR_BACKEND=acp

# claude | codex | cursor (when AUTHOR_BACKEND=acp)
VIDEOMAKER_COMPOSITION_ACP_AGENT=cursor

# hybrid = CompositionEngine (default) | legacy = old scaffold-only author
VIDEOMAKER_COMPOSITION_MODE=hybrid

# Cursor ACP: model slug and headless trust flag
VIDEOMAKER_CURSOR_ACP_MODEL=auto
VIDEOMAKER_CURSOR_ACP_TRUST=true

# Optional: override Cursor CLI path if not in %LOCALAPPDATA%\cursor-agent\agent.cmd
# VIDEOMAKER_CURSOR_AGENT_BIN=C:\Users\you\AppData\Local\cursor-agent\agent.cmd

# Per-slot ACP session timeout (seconds). Unset: 600 benefit-card, 1800 composition template.
# VIDEOMAKER_COMPOSITION_ACP_TIMEOUT_SEC=1800

# Lint acceleration + ACP in-session turn loop
VIDEOMAKER_COMPOSITION_LINT_CACHE=true
VIDEOMAKER_COMPOSITION_ACP_MAX_TURNS=5
VIDEOMAKER_COMPOSITION_ACP_SESSION_RETRY=1
# Deprecated: maps to MAX_TURNS - 1
VIDEOMAKER_COMPOSITION_ACP_LINT_REPAIR_MAX=1
VIDEOMAKER_COMPOSITION_ACP_AUTO_APPROVE=true

# Production E2E must use false (smoke scripts set true explicitly)
VIDEOMAKER_ACP_SMOKE_SIMPLE=false
# MCP write_material_spec lint for ACP (default on when unset)
VIDEOMAKER_MCP_WRITE_LINT_FOR_ACP=true

# Full E2E without master/storyboard pause (default true in production workbench)
# VIDEOMAKER_HUMAN_REVIEW_MODE=false

# Optional: override spawn command (JSON string array)
# VIDEOMAKER_COMPOSITION_ACP_AGENT_COMMAND=["C:\\path\\to\\agent.cmd","--trust","--model","auto","acp"]

# --- Concurrency (API process + worker material stage) ---
# API: max generation/revise worker subprocesses (dual variant plan uses 2 slots at cap=2)
# VIDEOMAKER_MAX_CONCURRENT_GENERATIONS=2
# API: sample analysis queue (unchanged)
# VIDEOMAKER_MAX_CONCURRENT_SAMPLE_ANALYSIS=2
# Worker: parallel visual-slot material chains per generation (1 = legacy serial; ACP 建议 1)
# VIDEOMAKER_MATERIAL_MAX_CONCURRENT_SLOTS=3
# Worker: per-slot material chain timeout (seconds); overall wait ~= timeout * slot count
# VIDEOMAKER_MATERIAL_SLOT_TIMEOUT_SEC=2400

# --- Model gateway HTTP timeouts (OpenAI-compatible chat) ---
# Short slot previews (<=30s) with base64 video upload often exceed 120s upstream inference.
# VIDEOMAKER_GATEWAY_CHAT_TIMEOUT_SEC=300
# VIDEOMAKER_GATEWAY_VISION_TIMEOUT_SEC=240
# VIDEOMAKER_GATEWAY_VIDEO_UNDERSTANDING_TIMEOUT_SEC=300
# Cancel/retry via API terminates the worker subprocess (taskkill on Windows).

# --- Other worker knobs (uncomment as needed) ---
# VIDEOMAKER_RENDER_BACKEND=ffmpeg
# VIDEOMAKER_FIXTURE_MODE=false
