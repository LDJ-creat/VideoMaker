# Copy to langfuse.env (gitignored) and fill in your Langfuse Cloud keys.
# Loaded automatically by services/api/run-dev.ps1 when present.

LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me

# Langfuse Cloud region (set if your project is not on EU default):
# EU (default):  https://cloud.langfuse.com
# US:            https://us.cloud.langfuse.com
# Japan:         https://jp.cloud.langfuse.com
# HIPAA US:      https://hipaa.cloud.langfuse.com
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# Self-hosted (either variable works):
# LANGFUSE_BASE_URL=https://your-langfuse.example.com
# LANGFUSE_HOST=https://your-langfuse.example.com

# full | summary | off  (default: full)
VIDEOMAKER_OBSERVABILITY_CAPTURE=full

# Optional: Langfuse-only capture override (defaults to VIDEOMAKER_OBSERVABILITY_CAPTURE)
# LANGFUSE_CAPTURE=summary
